# NAVI — Orca TI. Copie para .env e preencha. NUNCA versionar o .env.
# --- Banco da NAVI (PostgreSQL, SSL) ---
NAVI_DB_HOST=
NAVI_DB_NAME=navi
NAVI_DB_USER=navi
NAVI_DB_PASSWORD=
NAVI_SECRET_KEY=            # string longa e aleatoria (assina sessoes e cifra segredos do painel)
# --- Admin inicial (senha vira hash Argon2 no primeiro start) ---
NAVI_ADMIN_EMAIL=
NAVI_ADMIN_INITIAL_PASSWORD=
# --- Zabbix (fonte de dados, via API) ---
ZABBIX_URL=https://sonar.orcati.com.br/zabbix/api_jsonrpc.php
ZABBIX_API_TOKEN=
ZABBIX_DB_HOST=             # somente referencia/diagnostico; a NAVI usa a API
ZABBIX_DB_NAME=
ZABBIX_DB_USER=
ZABBIX_DB_PASSWORD=
# --- Evolution API (WhatsApp) ---
EVOLUTION_API_URL=https://orcafy.orcati.com.br/evolution
EVOLUTION_INSTANCE=
EVOLUTION_API_KEY=
# --- SMTP ---
SMTP_HOST=smtp.office365.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
# --- Manutencao (nao usados pelo app) ---
PG_ADMIN_HOST=
PG_ADMIN_USER=
PG_ADMIN_PASSWORD=
DBSRV_SSH_HOST=
DBSRV_SSH_USER=
DBSRV_SSH_PASSWORD=

# Acronis (preencher no .env)
ACRONIS_URL=
ACRONIS_CLIENT_ID=
ACRONIS_CLIENT_SECRET=

# FortiClient EMS (preencher no .env)
EMS_HOST=
EMS_API_KEY=
