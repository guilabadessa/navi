{
  "appId": "br.com.orcati.navi",
  "appName": "NAVI",
  "webDir": "www",
  "server": {
    "url": "https://navi.orcati.com.br/cliente/",
    "cleartext": false,
    "allowNavigation": [
      "navi.orcati.com.br"
    ],
    "errorPath": "offline.html"
  },
  "android": {
    "allowMixedContent": false
  },
  "plugins": {
    "PushNotifications": {
      "presentationOptions": [
        "badge",
        "sound",
        "alert"
      ]
    }
  }
}
